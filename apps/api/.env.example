PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/sam.sqlite
NODE_ENV=development
DEV_AUTH_ENABLED=true
DEV_PAYMENTS_ENABLED=true
# Production: NODE_ENV=production; both DEV_* must be false.
# WeChat login adapter uses the server-only credentials below. Real payments
# remain unconfigured and are never reported as successful.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Never put AppSecret in miniapp/admin client builds. Production defaults to
# ./data/sam-production.sqlite and rejects databases containing demo records.
# Production browser management origins, comma-separated exact HTTPS origins.
CORS_ORIGINS=
