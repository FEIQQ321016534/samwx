/* components/product-card/product-card.wxss */
.product-card {
  background-color: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
}

.image-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
  background-color: #f8fafc;
}

.product-image {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
}

.badge.cold-chain {
  top: 12rpx;
  left: 12rpx;
  background-color: rgba(2, 132, 199, 0.9);
}

.badge.split-tag {
  bottom: 12rpx;
  left: 12rpx;
  background-color: #f59e0b;
}

.content-wrapper {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
  justify-content: space-between;
}

.title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.specs {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 22rpx;
  color: #e11d48;
  font-weight: 700;
}

.amount {
  font-size: 32rpx;
  color: #e11d48;
  font-weight: 700;
}

.unit {
  font-size: 20rpx;
  color: #f43f5e;
  margin-left: 4rpx;
}

.sales {
  font-size: 18rpx;
  color: #94a3b8;
}

.button-group {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.btn-split {
  flex: 1;
  background-color: #f59e0b;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-buy {
  flex: 1;
  background-color: #f1f5f9;
  color: #334155;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 10rpx 0;
  line-height: 1.4;
  margin: 0;
}

.btn-buy.full-width {
  flex: 1;
  background-color: #0055a5;
  color: #ffffff;
}
