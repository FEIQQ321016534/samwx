/* components/wechat-pay/wechat-pay.wxss */
.pay-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.pay-dialog {
  width: 620rpx;
  background-color: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.dialog-header {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.close-icon {
  font-size: 28rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.dialog-body {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.merchant-name {
  font-size: 24rpx;
  color: #64748b;
}

.pay-amount {
  font-size: 64rpx;
  font-weight: 700;
  color: #0f172a;
  margin-top: 12rpx;
}

.order-id {
  font-size: 20rpx;
  color: #94a3b8;
  font-family: monospace;
  margin-top: 8rpx;
}

.pwd-box {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.pwd-item {
  width: 76rpx;
  height: 76rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 16rpx;
  background-color: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pwd-dot {
  width: 22rpx;
  height: 22rpx;
  background-color: #0f172a;
  border-radius: 50%;
}

.keyboard-grid {
  background-color: #f1f5f9;
  padding: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.key-item {
  background-color: #ffffff;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  border-radius: 16rpx;
}

.key-item.empty {
  background-color: transparent;
}
